# Строка подключения Postgres.
# Локально: postgres://<user>@localhost:5432/vika_budget
# Vercel + Neon: возьмите POOLED connection string из Neon (host вида ...-pooler.neon.tech)
DATABASE_URL=

# Пароль для входа на сайт (single-user)
AUTH_PASSWORD=

# Секрет подписи cookie-сессии: openssl rand -hex 32
AUTH_SECRET=

# Часовой пояс пользователя — определяет «сегодня» для ввода трат
APP_TZ=Europe/Moscow
